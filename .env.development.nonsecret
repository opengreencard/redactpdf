# Committed non-secret development configuration. Secrets live in
# .env.development (gitignored) and the redaction-development 1Password item.
APP_MODE=development
# Local database values come from docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redaction_development
DB_USER=redaction
# Local URL used by Auth.js for callbacks.
NEXTAUTH_URL=http://localhost:3000
# Keep S3_BUCKET_PREFIX and NEXT_PUBLIC_S3_FILES_BUCKET in sync with
# getS3Bucket() in lib/storage/buckets.ts and k8s/setup-spaces.sh (dev).
S3_BUCKET_PREFIX=dev
NEXT_PUBLIC_S3_FILES_BUCKET=redaction-dev-files
