# Test mode is used by Jest and CI.
APP_MODE=test
# Recreate tables from models before Jest. Required for a fresh test database.
SETUP_TEST_DB=true
# Local test database values should match the test database service.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redaction_test
DB_USER=redaction
DB_PASS=redaction
# Any stable test-only value works; never reuse a production secret.
AUTH_SECRET=test-only-secret
# Google sign-in is not used by automated tests.
GOOGLE_CLIENT_ID=not-used-in-tests
GOOGLE_CLIENT_SECRET=not-used-in-tests
# Local callback base URL used by test requests.
NEXTAUTH_URL=http://localhost:3000
# Test-only bucket prefix and placeholders; S3 is not used by these tests.
S3_BUCKET_PREFIX=test
S3_ACCESS_KEY_ID=test-only-access-key
S3_SECRET_ACCESS_KEY=test-only-secret-key
