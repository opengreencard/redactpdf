# Copy to .env.test if you run Jest outside CI. Non-secret values live in
# .env.test.nonsecret.
DB_PASS=redaction
# Any stable test-only value works; never reuse a production secret.
AUTH_SECRET=test-only-secret
# Google sign-in is not used by automated tests.
GOOGLE_CLIENT_ID=not-used-in-tests
GOOGLE_CLIENT_SECRET=not-used-in-tests
# Test-only placeholders; S3 is not used by these tests.
S3_ACCESS_KEY_ID=test-only-access-key
S3_SECRET_ACCESS_KEY=test-only-secret-key
# OpenAI-compatible vision keys. You don't need all three:
# - GEMINI_API_KEY: required to re-record vision mocks or run manual tests
# - DEEPINFRA_API_KEY: optional, model comparisons
# - OPENAI_API_KEY: optional, model comparisons
# Recorded Jest tests replay mocks without live calls. To add another
# provider, see lib/ai/createOpenAICompatibleCompletion.ts.
GEMINI_API_KEY=test-only-gemini-key
DEEPINFRA_API_KEY=test-only-deepinfra-key
OPENAI_API_KEY=test-only-openai-key
