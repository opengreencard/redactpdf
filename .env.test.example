# Copy to .env.test if you run Jest outside CI. Non-secret values live in
# .env.test.nonsecret.
# Leave an API key empty. Recorded Jest tests replay mocks and do not call
# these services. The comment above each key says where to create it when
# you want to re-record a mock or run a manual test.
DB_PASS=redaction
# Any stable test-only value works; never reuse a production secret.
AUTH_SECRET=test-only-secret
# Google sign-in is not used by automated tests.
# Create at https://console.cloud.google.com/auth/clients.
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Create at https://cloud.digitalocean.com/spaces/access_keys?i=30dfb5
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# OpenAI-compatible vision keys. You don't need all three:
# - GEMINI_API_KEY: required to re-record vision mocks or run manual tests
# - DEEPINFRA_API_KEY: optional, model comparisons
# - OPENAI_API_KEY: optional, model comparisons
# Recorded Jest tests replay mocks without live calls. To add another
# provider, see lib/ai/createOpenAICompatibleCompletion.ts.
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Create at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
# Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=
