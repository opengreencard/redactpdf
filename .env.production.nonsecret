# Committed non-secret production configuration. Secrets live in
# .env.production (gitignored) and the redaction-production 1Password item.
APP_MODE=production
# Shared OpenGreenCard production database (same host as immigration production).
DB_HOST=ogcdb.opengreencard.com
DB_PORT=3306
DB_DATABASE=redactpdf_prod
DB_USER=redactpdf_prod
# Public URL used by Auth.js for callbacks.
NEXTAUTH_URL=https://redactpdf.ai
# Keep S3_BUCKET_PREFIX and NEXT_PUBLIC_S3_FILES_BUCKET in sync with
# getS3Bucket() in lib/storage/buckets.ts and k8s/setup-spaces.sh (prod).
S3_BUCKET_PREFIX=prod
NEXT_PUBLIC_S3_FILES_BUCKET=redaction-prod-files
