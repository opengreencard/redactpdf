# Copy to .env.production and replace placeholders. Non-secret values live in
# .env.production.nonsecret.
# Store the production password in 1Password; see k8s/1password/.
DB_PASS=replace-with-production-db-password
# Generate with: openssl rand -base64 32, then store it in 1Password.
AUTH_SECRET=replace-with-a-production-secret
# Create at https://console.cloud.google.com/auth/clients.
# Add https://redactpdf.ai/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Create at https://cloud.digitalocean.com/spaces/access_keys?i=30dfb5
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
# Create at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=replace-with-deepinfra-api-key
