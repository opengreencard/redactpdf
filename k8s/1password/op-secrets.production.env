# Keep vault and item names in sync with k8s/1password/variables.sh.
# These are 1Password references, not secret values.
DB_PASS=op://Production/redaction-production/DB_PASS
AUTH_SECRET=op://Production/redaction-production/AUTH_SECRET
GOOGLE_CLIENT_ID=op://Production/redaction-production/GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=op://Production/redaction-production/GOOGLE_CLIENT_SECRET
S3_ACCESS_KEY_ID=op://Production/redaction-production/S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=op://Production/redaction-production/S3_SECRET_ACCESS_KEY
DEEPINFRA_API_KEY=op://Production/redaction-production/DEEPINFRA_API_KEY
