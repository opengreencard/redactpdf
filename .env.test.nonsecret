# Committed non-secret test configuration. Secret placeholders live in
# .env.test.example; CI overrides credentials via workflow env.
APP_MODE=test
# Recreate tables from models before Jest. Required for a fresh test database.
SETUP_TEST_DB=true
# Local test database values should match the test database service.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=redaction_test
DB_USER=redaction
# Local callback base URL used by test requests.
NEXTAUTH_URL=http://localhost:3000
# Keep S3_BUCKET_PREFIX and NEXT_PUBLIC_S3_FILES_BUCKET in sync with
# getS3Bucket() in lib/storage/buckets.ts.
S3_BUCKET_PREFIX=test
NEXT_PUBLIC_S3_FILES_BUCKET=redaction-test-files
