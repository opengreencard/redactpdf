{
  "name": "redaction",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:eslint-plugin": "npm --prefix dev/eslint run build",
    "lint": "yarn build:eslint-plugin && npm run lint:stylelint && eslint .",
    "lint:stylelint": "stylelint '**/*.css' --cache",
    "jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "swc-node": "node -r @swc-node/register",
    "init-db-dev": "yarn swc-node scripts/initializeDatabases.ts",
    "init-db-prod": "APP_MODE=production yarn swc-node scripts/initializeDatabases.ts",
    "shellcheck": "find . -name '*.sh' -not -path './node_modules/*' -exec shellcheck --external-sources {} +",
    "prepare": "if command -v git >/dev/null 2>&1 && git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "postinstall": "patch-package"
  },
  "packageManager": "yarn@4.14.1",
  "dependencies": {
    "@auth/sequelize-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@cantoo/pdf-lib": "^2.8.4",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@mantine/core": "^9.5.1",
    "@mantine/dropzone": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fast-json-stable-stringify": "^2.1.0",
    "glob": "^13.0.6",
    "lodash": "^4.18.1",
    "mariadb": "^3.5.3",
    "next": "16",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.4.0",
    "patch-package": "^8.0.1",
    "pdf2pic": "^3.2.0",
    "randomstring": "^1.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "^15.0.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.3",
    "yargs": "^18.1.0",
    "zod": "^4.4.3",
    "zstd-napi": "^0.0.13"
  },
  "devDependencies": {
    "@naverpay/eslint-plugin-use-client": "^0.0.2",
    "@next/eslint-plugin-next": "^14.2.35",
    "@storybook/nextjs": "^10.5.8",
    "@storybook/react": "^10.5.8",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/bcrypt": "^6",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4",
    "@types/node": "^26.2.0",
    "@types/randomstring": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-mantine": "3.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "28.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-redaction": "link:dev/eslint",
    "eslint-plugin-testing-library": "6.2.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lefthook": "^2.1.10",
    "mockdate": "^3.0.5",
    "only-allow": "^1.2.2",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.6",
    "storybook": "^10.5.8",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0",
    "webpack": "^5.109.2"
  }
}
