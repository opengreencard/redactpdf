# Copy to .env.development and replace placeholders. Non-secret values live in
# .env.development.nonsecret.
DB_PASS=replace-with-development-db-password
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-development-secret
# Create at https://console.cloud.google.com/auth/clients.
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Create at https://cloud.digitalocean.com/spaces/access_keys?i=30dfb5
S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
# Create at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=replace-with-deepinfra-api-key
