# Copy to .env.development. Non-secret values live in
# .env.development.nonsecret.
# Leave a line empty until you have that credential. The comment above the
# line says where to create it. Cursor Cloud install
# (.cursor/cloud-agent-install.sh) fills empty development lines with
# local-only stand-ins. It does not replace a value you already set.
# Local MariaDB password. Matches docker-compose.yml (default: redaction).
DB_PASS=redaction
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Create at https://console.cloud.google.com/auth/clients.
# Add http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Create at https://cloud.digitalocean.com/spaces/access_keys?i=30dfb5
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# OpenAI-compatible vision keys. You don't need all three:
# - GEMINI_API_KEY: required to run production-style redaction
# - DEEPINFRA_API_KEY: optional, model comparisons
# - OPENAI_API_KEY: optional, model comparisons
# To add another provider, see lib/ai/createOpenAICompatibleCompletion.ts.
# Create at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Create at https://deepinfra.com/dash/api_keys
DEEPINFRA_API_KEY=
# Create at https://platform.openai.com/api-keys
OPENAI_API_KEY=
